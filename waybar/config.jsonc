{
  "layer": "top",
  "position": "top",
  "height": 28,
  "include": [
    "~/.config/waybar/modules/left.jsonc",
    "~/.config/waybar/modules/center.jsonc",
    "~/.config/waybar/modules/right.jsonc"
  ],
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "backlight", "network", "bluetooth", "pulseaudio", "battery"]
}
